# Public local development URLs. Convex creates .env.local on first startup.
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Optional official branding. Leave empty until the original transparent logo is supplied.
VITE_VISO_LOGO_URL=
# Optional official store URL. No store is configured yet.
VITE_VISO_STORE_URL=

# Browser-only validation of the three native Deck presets. The APK uses Android detection.
VITE_ANDROID_DECK_PRESETS=false

# Canonical HTTPS website for printed Timbre QR codes and invitations.
# Android builds forward VISO_ANDROID_WEB_URL to this public setting.
VITE_PUBLIC_APP_URL=

# Timbre server configuration: set these in the Convex deployment, not as
# VITE_ variables. The empty defaults do not enable calls, push or recurring fees.
# Cloudflare managed TURN: set provider=cloudflare and fill its two values in
# Convex Settings > Environment Variables. Merely filling this template does not
# update the hosted backend. Never share or commit real credentials.
TIMBRE_TURN_PROVIDER=
TIMBRE_CLOUDFLARE_TURN_KEY_ID=
TIMBRE_CLOUDFLARE_TURN_API_TOKEN=
# Alternative provider=coturn (or omitted provider for existing coturn setups).
TIMBRE_TURN_URLS=
TIMBRE_TURN_SECRET=
TIMBRE_FCM_SERVICE_ACCOUNT=
TIMBRE_RECURRING_ENABLED=false
