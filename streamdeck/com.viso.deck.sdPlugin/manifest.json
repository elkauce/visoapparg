      "Icon": "imgs/off",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/off",
          "Title": "APAGAR",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    }
  ]
}