{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.viso.deck",
  "Name": "VISO Deck",
  "Description": "Cambiá los estados de tu cuenta VISO desde Elgato Stream Deck.",
  "Author": "VISO",
  "Version": "1.1.0.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "CodePath": "bin/plugin.mjs",
  "Icon": "imgs/viso",
  "Category": "VISO Deck",
  "CategoryIcon": "imgs/viso",
  "Actions": [
    {
      "UUID": "com.viso.deck.state",
      "Name": "Estado VISO",
      "Tooltip": "Elegí cualquier estado personalizado de tu cuenta VISO.",
      "Icon": "imgs/viso",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/viso",
          "Title": "VISO"
        }
      ]
    },
    {
      "UUID": "com.viso.deck.libre",
      "Name": "LIBRE",
      "Tooltip": "Activa LIBRE en tu cuenta VISO.",
      "Icon": "imgs/libre",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/libre",
          "Title": "LIBRE",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "com.viso.deck.ocupado",
      "Name": "OCUPADO",
      "Tooltip": "Activa OCUPADO en tu cuenta VISO.",
      "Icon": "imgs/ocupado",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/ocupado",
          "Title": "OCUPADO",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "com.viso.deck.reunion",
      "Name": "REUNIÓN",
      "Tooltip": "Activa REUNIÓN en tu cuenta VISO.",
      "Icon": "imgs/reunion",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/reunion",
          "Title": "REUNIÓN",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "com.viso.deck.llamada",
      "Name": "LLAMADA",
      "Tooltip": "Activa LLAMADA en tu cuenta VISO.",
      "Icon": "imgs/llamada",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/llamada",
          "Title": "LLAMADA",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "com.viso.deck.no-molestar",
      "Name": "NO MOLESTAR",
      "Tooltip": "Activa NO MOLESTAR en tu cuenta VISO.",
      "Icon": "imgs/no-molestar",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/no-molestar",
          "Title": "NO MOLESTAR",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "com.viso.deck.ausente",
      "Name": "AUSENTE",
      "Tooltip": "Activa AUSENTE en tu cuenta VISO.",
